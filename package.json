{
  "name": "la-cour-des-grands",
  "version": "0.1.0",
  "private": true,
  "description": "La Cour des Grands : duel tactique mobile dans une cour de récré.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "simulate": "tsx scripts/simulate.ts",
    "arene": "tsx scripts/arene.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "serveur:construire": "tsx scripts/construire-arbitre.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
